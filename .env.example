# Copie este arquivo para .env antes de iniciar o Docker Compose.
# Troque todas as credenciais antes de usar o projeto fora do ambiente local.
MYSQL_DATABASE=baozi_store
MYSQL_USER=baozi
MYSQL_PASSWORD=troque-esta-senha-local
MYSQL_ROOT_PASSWORD=troque-esta-senha-root-local
MYSQL_PORT=3307

JWT_SECRET=troque-esta-chave-jwt-com-pelo-menos-32-caracteres
JWT_EXPIRATION=86400000

BACKEND_PORT=8080
FRONTEND_PORT=5173
